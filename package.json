{
  "name": "cerberus",
  "version": "1.0.0",
  "workspaces": ["packages/*"],
  "scripts": {
    "start:cli": "bun run packages/cli/src/main.ts",
    "dev:cli": "bun run --watch packages/cli/src/main.ts",
    "dev:server": "dotnet run --no-launch-profile --project backend/src/Cerberus.Api",
    "dev:server:lite": "sh scripts/dev-api-lite.sh",
    "check:cli": "bun run --cwd packages/cli typecheck && bun run --cwd packages/cli test",
    "test:scripts": "bun test scripts",
    "build:cli": "bun run --filter @cerberus/cli build",
    "link:cli": "bun run build:cli && cd packages/cli && bun link"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
