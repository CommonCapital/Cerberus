{
  "name": "cerberus",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CommonCapital/Cerberus.git"
  },
  "version": "1.0.0",
  "workspaces": [
    "frontend/*"
  ],
  "scripts": {
    "dev:cli": "bun run --watch frontend/cli/src/main.ts",
    "dev:server": "bun run --hot frontend/server/src/index.ts",
    "build:cli": "bun run --filter @cerberus/cli build",
    "link:cli": "bun run build:cli && cd frontend/cli && bun link"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  },
  "private": true
}
