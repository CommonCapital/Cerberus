# Cerberus — local configuration. No cloud services required.

# API server
API_URL=http://localhost:3000

# Local database (SQLite). Defaults to ./cerberus.db if unset.
DATABASE_URL=file:./cerberus.db

# --- Models -------------------------------------------------------------
# Supply your own keys for cloud models (optional). Leave blank to use only
# local Ollama models.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# Local models via Ollama (https://ollama.com). Optional override of the
# default endpoint. Pull a model first, e.g. `ollama pull llama3.1`.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Local CLI login (optional) ----------------------------------------
# Credentials the CLI uses to sign in to the local server. Defaults are used
# if unset; the account is auto-created on first login.
# CERBERUS_EMAIL=local@cerberus.local
# CERBERUS_PASSWORD=local-dev-password

# --- Docker Compose (optional) ------------------------------------------
# Only read by docker-compose.yml. See PLAN.md §15.
# Directory mounted into the API (read-only, to scan) and the CLI (to work in).
# CERBERUS_TARGET=.
# Port the API is published on, on this machine only.
# CERBERUS_PORT=3000
# Password for the optional RabbitMQ container (profile "infra").
# RABBITMQ_PASSWORD=
