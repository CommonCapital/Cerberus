# Cerberus — local configuration. No cloud services required.

# API server
API_URL=http://localhost:3000

# Local database (SQLite). Defaults to ./cerberus.db if unset.
DATABASE_URL=file:./cerberus.db

# --- Models -------------------------------------------------------------
# Supply your own keys for cloud models (optional). Leave blank to use only
# local Ollama models.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# Local models via Ollama (https://ollama.com). Optional override of the
# default endpoint. Pull a model first, e.g. `ollama pull llama3.1`.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Local CLI login (optional) ----------------------------------------
# Credentials the CLI uses to sign in to the local server. Defaults are used
# if unset; the account is auto-created on first login.
# CERBERUS_EMAIL=local@cerberus.local
# CERBERUS_PASSWORD=local-dev-password

# --- Docker Compose (optional) ------------------------------------------
# Only read by docker-compose.yml.
# Directory mounted into the API (read-only, to scan) and the CLI (to work in).
# CERBERUS_TARGET=.
# Port the API is published on, on this machine only.
# CERBERUS_PORT=3000
# Required by compose.infra.yml (PostgreSQL, RabbitMQ and Redis): there are no default passwords.
# POSTGRES_PASSWORD=
# RABBITMQ_PASSWORD=
# Host ports of that stack, if 5432, 5672, 15672 or 6379 are already taken on this machine.
# POSTGRES_PORT=5432
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672
# REDIS_PORT=6379
#
# Running the API without containers (dotnet run), these point it at services of your own. Each one that
# answers within a few seconds of the start is used; one that does not is replaced by its local stand-in
# (SQLite, the queue in the process, this process alone) and the API starts anyway. Readiness says which.
# CERBERUS_POSTGRES_URL=postgres://cerberus:password@localhost:5432/cerberus
# CERBERUS_REDIS_URL=redis://localhost:6379
# CERBERUS_RABBITMQ_URL=amqp://cerberus:password@localhost:5672/
# How long to wait for them at start-up, in seconds (default 5).
# CERBERUS_SERVICE_WAIT_SECONDS=5
# "true": a configured service that does not answer stops the start instead (several copies of the API
# must not each fall back on their own). compose.infra.yml sets it.
# CERBERUS_REQUIRE_SERVICES=false
#
# With compose.cluster.yml (two copies of the API behind a proxy): the HTTPS port on this machine, and
# the network range and the proxy's address if 172.31.250.0/24 is taken.
# CERBERUS_TLS_PORT=3443
# CERBERUS_CLUSTER_SUBNET=172.31.250.0/24
# CERBERUS_CLUSTER_IP_RANGE=172.31.250.128/25
# CERBERUS_PROXY_ADDRESS=172.31.250.2
#
# Running the API behind a reverse proxy of your own: the proxy's address (or network), whose
# X-Forwarded-For is then believed for the client's address. Anyone else's is ignored. Unset: nobody's.
# CERBERUS_TRUSTED_PROXIES=10.0.0.5
